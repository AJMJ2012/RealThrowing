Configs: {
	ServerConfig: {
		DisplayName: Server Config

		Headers: {
			Prefixes: Prefixes
			AutomaticConversions: Automatic Conversions
			IgnoredWeapons: Ignored Weapons
			Forced: Forced Weapons
			ModIntegration: Mod Integration
			DamageType: Damage Type
			Ignored: Ignored
		}

		ConvertThrown: {
			Label: Convert Thrown
			Tooltip: Allows thrown weapons to be converted
		}

		ConvertFlails: {
			Label: Convert Flails
			Tooltip: Allows flails to be converted
		}

		ConvertYoyos: {
			Label: Convert Yoyos
			Tooltip: Allows yoyos to be converted
		}

		ConvertSplitRaquets: {
			Label: Convert Split Raquets
			Tooltip: ""
		}

		ToType: {
			Label: To Damage Type
			Tooltip: ""
		}

		GenericPrefixes: {
			Label: Allow Generic
			Tooltip:
				'''
				Best left enabled
				Only applicable when weapon damage type is Throwing
				Ignored if Thorium Mod is installed
				'''
		}

		RangedPrefixes: {
			Label: Allow Ranged
			Tooltip:
				'''
				Turn off if there are Throwing prefixes
				Only applicable when weapon damage type is Throwing
				Ignored if Thorium Mod is installed
				'''
		}

		MeleePrefixes: {
			Label: Allow Melee
			Tooltip:
				'''
				Turn off if there are Throwing prefixes
				Only applicable when weapon damage type is Throwing
				Ignored if Thorium Mod is installed
				'''
		}

		IgnoredLists: {
			Label: Ignored Weapons
			Tooltip: ""
		}

		ForcedLists: {
			Label: Forced Weapons
			Tooltip: ""
		}

		HardIgnoredLists: {
			Label: Hard Ignored Weapons
			Tooltip: ""
		}

		HardForcedLists: {
