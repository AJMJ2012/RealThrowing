			Tooltip: ""
		}
	}

	IgnoredListsSection: {
		Tooltip: ""

		Headers: {
			Weapons: Weapons
			Projectiles: Projectiles
			Info: Info
		}

		Weapons: {
			Label: By IDs
			Tooltip: All weapons in this list will not be automatically converted
		}

		WeaponClasses: {
			Label: By Classes [Advanced]
			Tooltip:
				'''
				All weapon classes in this list will not be automatically converted
				Wildcard usage is advised
				'''
		}

		WeaponProjectiles: {
			Label: By IDs
			Tooltip: All weapons that shoot projectiles in this list will not be automatically converted
		}

		WeaponProjectileClasses: {
			Label: By Classes [Advanced]
			Tooltip:
				'''
				All weapon projectile classes in this list will not be automatically converted
				Wildcard usage is advised
				'''
		}

		ReadMe: {
			Label: Read Me!
			Tooltip: Some weapons may wrongfully be converted and need to be added to one of these lists
		}
	}

	HardIgnoredListsSection: {
		Tooltip: ""

		Headers: {
			Weapons: Weapons
			Projectiles: Projectiles
