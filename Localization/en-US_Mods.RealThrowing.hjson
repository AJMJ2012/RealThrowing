		}

		WeaponProjectileAIStyles: {
			Label: By AI Styles
			Tooltip: All weapons that shoot projectiles with AI styles in this list will not be automatically converted
		}

		ReadMe: {
			Label: Read Me!
			Tooltip:
				'''
				Some weapons may wrongfully be converted and have been added to these lists
